<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <include
        android:id="@+id/topBarComponent"
        layout="@layout/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/bottomNavComponent"
        layout="@layout/layout_bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:layout_constraintBottom_toBottomOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNavComponent"
        app:layout_constraintTop_toBottomOf="@id/topBarComponent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HEADER: document name is set from Java -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/doc_header_mint"
                android:orientation="vertical"
                android:paddingBottom="16dp"
                android:paddingHorizontal="16dp"
                android:paddingTop="14dp">

                <LinearLayout
                    android:id="@+id/btnBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="Bumalik"
                        android:src="@drawable/ic_doc_arrow_back"
                        app:tint="@color/nav_green_active" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Bumalik sa Mga Dokumento"
                        android:textColor="@color/nav_green_active"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_doc_folder"
                        app:tint="@color/text_gray_green" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="DOKUMENTONG HINIHILING"
                        android:textColor="@color/text_gray_green"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDocumentTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Dokumento"
                    android:textColor="@color/nav_green_active"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Isumite ang larawan ng resibo ng bayad at kumpirmahin ang mga pagpapatunay sa ibaba."
                    android:textColor="@color/text_gray_green"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- BODY -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Larawan ng Resibo"
                    android:textColor="@color/nav_green_active"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <!-- Image submission box -->
                <FrameLayout
                    android:id="@+id/btnUploadReceipt"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_doc_status_strip"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:padding="1dp">

                    <LinearLayout
                        android:id="@+id/layoutUploadPlaceholder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            style="@style/DocIconTile"
                            android:src="@drawable/ic_doc_attach"
                            app:tint="@color/nav_green_active" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Mag-upload ng larawan ng resibo"
                            android:textColor="@color/nav_green_active"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/DocMicroLabel"
                            android:layout_marginTop="2dp"
                            android:text="Pindutin dito upang pumili mula sa gallery"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivReceiptPreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Larawan ng resibo"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvReceiptStatus"
                    style="@style/DocMicroLabel"
                    android:layout_marginTop="6dp"
                    android:text="Walang napiling larawan"
                    android:textSize="12sp" />

                <!-- Pagpapatunay -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Pagpapatunay"
                    android:textColor="@color/nav_green_active"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_doc_card"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <CheckBox
                        android:id="@+id/cbInfoCertification"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/doc_dark_green"
                        android:gravity="top|start"
                        android:paddingStart="8dp"
                        android:paddingVertical="8dp"
                        android:text="Pagpapatunay ng Impormasyon: Pinatutunayan ko na tama at wasto ang lahat ng impormasyong aking ibinigay. Anumang rebisyon dahil sa maling impormasyong aking isinumite ay aking sasagutin."
                        android:textColor="@color/nav_green_active"
                        android:textSize="13sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="8dp"
                        android:background="@color/doc_card_stroke" />

                    <CheckBox
                        android:id="@+id/cbRequesterCertification"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/doc_dark_green"
                        android:gravity="top|start"
                        android:paddingStart="8dp"
                        android:paddingVertical="8dp"
                        android:text="Pagpapatunay ng Humihiling: Pinatutunayan ko na ako mismo ang taong humihiling at nagpapagawa ng dokumentong ito."
                        android:textColor="@color/nav_green_active"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Submit -->
                <TextView
                    android:id="@+id/btnSubmitReceipt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_doc_call_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:padding="14dp"
                    android:text="Isumite ang Resibo"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="8dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>