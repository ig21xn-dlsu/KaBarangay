<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_marginBottom="8dp"
	android:background="@drawable/bg_rounded_card_beige"
	android:clickable="true"
	android:focusable="true"
	android:gravity="center_vertical"
	android:orientation="horizontal"
	android:padding="12dp">

	<ImageView
		android:id="@+id/ivEquipmentImage"
		android:layout_width="64dp"
		android:layout_height="64dp"
		android:background="@drawable/bg_input_field"
		android:contentDescription="Equipment image"
		android:padding="16dp"
		android:src="@drawable/ic_logo_placeholder" />

	<LinearLayout
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_marginStart="12dp"
		android:layout_weight="1"
		android:orientation="vertical">

		<TextView
			android:id="@+id/tvEquipmentCategory"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textColor="@color/text_gray_green"
			android:textSize="10sp"
			android:textStyle="bold" />

		<TextView
			android:id="@+id/tvEquipmentTitle"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="3dp"
			android:textColor="@color/nav_green_active"
			android:textSize="16sp"
			android:textStyle="bold" />

		<TextView
			android:id="@+id/tvEquipmentDescription"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="2dp"
			android:textColor="@color/text_gray_green"
			android:textSize="12sp" />

		<TextView
			android:id="@+id/tvEquipmentAvailability"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="6dp"
			android:background="@drawable/bg_badge"
			android:backgroundTint="#DDEBE0"
			android:paddingHorizontal="8dp"
			android:paddingVertical="4dp"
			android:textColor="@color/nav_green_active"
			android:textSize="11sp"
			android:textStyle="bold" />
	</LinearLayout>

	<ImageView
		android:layout_width="32dp"
		android:layout_height="32dp"
		android:background="@drawable/bg_circle_icon"
		android:contentDescription="Open booking form"
		android:padding="8dp"
		android:src="@drawable/ic_chevron_right"
		android:tint="@color/white" />
</LinearLayout>
