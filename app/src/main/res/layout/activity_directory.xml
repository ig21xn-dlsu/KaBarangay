<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    tools:context=".activities.DirectoryActivity">

    <include
        android:id="@+id/topBarComponent"
        layout="@layout/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintTop_toBottomOf="@id/topBarComponent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/btnBackToServices"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Bumalik sa Mga Serbisyo"
                android:textColor="@color/nav_green_active"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Directory ng Barangay"
                android:textColor="@color/primary_dark"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lokasyon ng Tanggapan, Oras ng Pagbubukas, at Talaan ng mga Opisyal"
                android:textColor="@color/text_gray_green"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_rounded_card_beige"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OPISINA NG PUNONG BARANGAY / HALL DESK"
                    android:textColor="@color/accent_orange"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="TIRAHAN NG TANGGAPAN\n#101 Barangay Hall Compound\nITISMOB Community Center, Katipunan St. corner Rizal Ave."
                    android:textColor="@color/primary_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_rounded_card_green"
                    android:padding="12dp"
                    android:text="ORAS NG TANGGAPAN (DESK SCHEDULE)\nLunes hanggang Biyernes: 8:00 AM - 5:00 PM\nSabado: 8:00 AM - 12:00 NN\nLinggo: Sarado ang regular Hall Desk"
                    android:textColor="@color/nav_green_active"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnCallDesk"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_primary"
                        android:text="Tumawag\n8-700-112"
                        android:textColor="@color/white"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnEmailDesk"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_secondary"
                        android:text="Sumulat\nOpisyal Mail"
                        android:textColor="@color/nav_green_active"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Mga Opisyal ng Barangay"
                android:textColor="@color/primary_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">
                <include layout="@layout/item_directory_official" android:id="@+id/officialCaptain" />
                <include layout="@layout/item_directory_official" android:id="@+id/officialKagawad1" />
                <include layout="@layout/item_directory_official" android:id="@+id/officialKagawad2" />
                <include layout="@layout/item_directory_official" android:id="@+id/officialSecretary" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_rounded_card_green"
                android:padding="14dp"
                android:text="ⓘ Paalala sa mga Walk-In na Mamamayan\nPara sa mga clearance at sertipikasyon, magdala ng dalawang (2) valid ID at patunay ng paninirahan sa ITISMOB bago magtungo sa Hall Desk."
                android:textColor="@color/text_gray_green"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/layout_bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>