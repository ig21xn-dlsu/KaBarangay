<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomNavigation"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@color/cream"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:gravity="center_vertical">

    <!-- 1. Saklolo (Hotlines / Emergency) -->
    <LinearLayout
        android:id="@+id/navSaklolo"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivSakloloIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_asterisk"
            app:tint="@color/emergency_red" />

        <TextView
            android:id="@+id/tvSakloloText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Saklolo"
            android:textColor="@color/emergency_red"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2. Tahanan (Home) -->
    <LinearLayout
        android:id="@+id/navTahanan"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivTahananIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_home"
            app:tint="@color/nav_green_active" />

        <TextView
            android:id="@+id/tvTahananText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tahanan"
            android:textColor="@color/nav_green_active"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 3. Profile (Profile) -->
    <LinearLayout
        android:id="@+id/navProfile"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivProfileIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_person"
            app:tint="@color/nav_green_inactive" />

        <TextView
            android:id="@+id/tvProfileText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Profile"
            android:textColor="@color/nav_green_inactive"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>